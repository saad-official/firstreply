# Copy to .env.local for development. Never commit real values.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Firstreply

# Database (Postgres). Leave empty for embedded PGlite in development: data
# lives in .pglite/ and migrations apply on first use. In production use the
# pooled connection string (all tables live in the "firstreply" schema), and
# run `pnpm db:migrate` with the direct (non-pooled) one. The first migration
# runs `create extension if not exists vector` (pgvector; available on Neon),
# so the migrating role needs permission to create extensions.
DATABASE_URL=

# Auth (Better Auth). Generate the secret with: openssl rand -base64 32
# Required in production; development falls back to a public dev secret.
BETTER_AUTH_SECRET=
# Public origin of the app; defaults to NEXT_PUBLIC_APP_URL.
BETTER_AUTH_URL=

# LLM providers (free tiers). Groq is primary, Gemini is fallback and vision.
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
AI_PRIMARY_MODEL=openai/gpt-oss-20b
AI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Stripe (sandbox / test mode only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO_MONTHLY=

# Email. Leave RESEND_API_KEY empty to use the in-app Outbox only.
# With a key but no verified domain, set EMAIL_DEMO_RECIPIENT to your own address:
# every message is delivered there with a banner naming the intended recipient.
RESEND_API_KEY=
EMAIL_FROM=Firstreply <onboarding@resend.dev>
EMAIL_DEMO_RECIPIENT=

# Background jobs
CRON_SECRET=
